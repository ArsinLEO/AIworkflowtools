# Ignore all PNG images
*.png
*.PNG

# Ignore input/output contents but keep directory structure
RemoveWatermarkTool/input/*
!RemoveWatermarkTool/input/.gitkeep
RemoveWatermarkTool/output/*
!RemoveWatermarkTool/output/.gitkeep

ResizeAndLocalTool/input/*
!ResizeAndLocalTool/input/.gitkeep
ResizeAndLocalTool/output/*
!ResizeAndLocalTool/output/.gitkeep
ResizeAndLocalTool/reference/*
!ResizeAndLocalTool/reference/.gitkeep

SpriteSheetTool/input/*
!SpriteSheetTool/input/.gitkeep
SpriteSheetTool/output/*
!SpriteSheetTool/output/.gitkeep

SpriteSheetSplitterTool/input/*
!SpriteSheetSplitterTool/input/.gitkeep
SpriteSheetSplitterTool/output/*
!SpriteSheetSplitterTool/output/.gitkeep

VideoToSpriteSheetTool/input/*
!VideoToSpriteSheetTool/input/.gitkeep
VideoToSpriteSheetTool/output/*
!VideoToSpriteSheetTool/output/.gitkeep
VideoToSpriteSheetTool/frames/

GreenMagentaRemovalTool/input/*
!GreenMagentaRemovalTool/input/.gitkeep
GreenMagentaRemovalTool/output/*
!GreenMagentaRemovalTool/output/.gitkeep

ShadowRemovalTool/input/*
!ShadowRemovalTool/input/.gitkeep
ShadowRemovalTool/output/*
!ShadowRemovalTool/output/.gitkeep

# Runtime generated files
align_params.json

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db
